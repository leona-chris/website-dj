---
import { url } from '../utils/path.js';
---

<section id="hero-section" class="hero min-h-screen relative overflow-hidden cursor-pointer">

    <!-- Background video with blur effect -->
    <video 
        autoplay 
        muted 
        loop 
        playsinline 
        preload="auto" 
        poster={url('img/leona_chris_hero.webp')} 
        class="absolute inset-0 object-cover blur-[8px] scale-105 pointer-events-none"
    >
        <source src={url('vid/leona_chris_hero.mp4')} type="video/mp4">
    </video>
        
    <!-- Overlay -->
    <div class="hero-overlay bg-base-100/5"></div>

    <!-- Overlay content with glass effect -->
    <div class="hero-content text-center z-10 px-4 w-full">
        <div class="w-full max-w-5xl bg-base-100/25 backdrop-blur-md p-8 md:p-12 rounded-3xl shadow-2xl border border-primary/25">
            
            <!-- DJ names -->
            <h1 class="flex flex-wrap justify-center items-center gap-x-3 md:gap-x-5 gap-y-2 text-4xl md:text-7xl font-black tracking-tight mb-4 uppercase drop-shadow-md">
                <span class="text-primary whitespace-nowrap">La Leona</span> 
                <span class="text-secondary">&amp;</span> 
                <span class="text-accent whitespace-nowrap">Chris.Me</span>
            </h1>

            <!-- Genres -->
            <p class="text-xs md:text-sm font-bold uppercase tracking-[0.25em] text-white/95 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] mt-6 leading-relaxed">
                Bouncy • Bass House • Tech House • Indie Dance • Melodic House & Techno
            </p>

        </div>
    </div>
    
</section>

<script>
    const heroSection = document.getElementById('hero-section');
    
    heroSection?.addEventListener('click', () => {
        const aboutSection = document.getElementById('about');
        aboutSection?.scrollIntoView({ behavior: 'smooth' });
    });
</script>