---
// Import content from JSON file
import aboutData from '../data/about.json';
---

<section id="about" class="py-24 px-8 bg-base-200/50">

    <div class="max-w-3xl mx-auto text-center">

        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-8">About Us</h2>

        <!-- Dynamic output of JSON content -->
        {aboutData.paragraphs.map((paragraph) => (
            <p class="opacity-85 leading-relaxed text-base md:text-lg mb-6">
                {paragraph}
            </p>
        ))}

    </div>

    <!-- Schwebende, minimalistische Badge-Leiste mit dezenter Trennlinie -->
    <div class="max-w-xl mx-auto mt-12 pt-8 border-t border-primary/20 flex flex-wrap items-center justify-center gap-3">
        
        <!-- Munich-Based mit Funkel-Effekt -->
        <div class="group inline-flex items-center gap-2 px-4 py-2 rounded-full bg-base-100/80 backdrop-blur-sm shadow-sm border border-primary/30 text-xs font-bold uppercase tracking-wider cursor-pointer transition-all hover:border-primary hover:shadow-md">
            <svg class="sparkle-icon w-4 h-4 text-primary transition-all duration-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
            Munich-Based
        </div>

        <!-- Escon Collective Link -->
        <a href="https://www.instagram.com/escon.events/" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-base-100/80 backdrop-blur-sm shadow-sm border border-primary/30 text-xs font-bold uppercase tracking-wider transition-all hover:border-primary hover:text-primary hover:shadow-md">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Escon Collective
        </a>

        <!-- Why Not Family Link -->
        <a href="https://www.instagram.com/camp.whynot/" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-base-100/80 backdrop-blur-sm shadow-sm border border-primary/30 text-xs font-bold uppercase tracking-wider transition-all hover:border-secondary hover:text-secondary hover:shadow-md">
            <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            Why Not Family
        </a>

    </div>
    
</section>