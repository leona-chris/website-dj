---
// src/components/Impressions.astro
import { Image } from 'astro:assets';
import photosData from '../data/photos.json';
import videosData from '../data/videos.json';

// Automatisches Laden und Optimieren aller Fotos aus src/assets/
const imageFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpeg,jpg,png,webp}', { eager: true });

const photos = Object.entries(imageFiles).map(([path, module]) => {
    const fileNameWithExt = path.split('/').pop() || '';
    const baseName = fileNameWithExt.split('.')[0];
    const caption = photosData[baseName] || 'La Leona & Chris.Me Moment';
    return {
        imageObj: module.default,
        src: module.default.src,
        caption
    };
});

const videos = videosData;
---

<section id="gallery" class="py-24 px-8 max-w-4xl mx-auto">
    <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Live Impressions</h2>
    </div>

    <!-- Unterabschnitt 1: Fotos -->
    <div class="mb-16">
        <div class="text-center mb-8">
            <p class="text-sm opacity-80">A glimpse of the dancefloor magic.</p>
        </div>

        <div class="carousel carousel-center w-full space-x-4 p-4 bg-base-200/60 rounded-2xl shadow-xl border border-primary/20">
            {photos.map((photo, idx) => (
                <div class="carousel-item w-72 md:w-80">
                    <div 
                        class="photo-trigger relative w-full rounded-xl overflow-hidden shadow-lg bg-base-100 aspect-square group cursor-pointer border border-primary/20" 
                        data-index={idx}
                        title={photo.caption}
                    >
                        <Image 
                            src={photo.imageObj} 
                            alt={photo.caption} 
                            width={400}
                            height={400}
                            class="w-full h-full object-cover pointer-events-none transition-transform duration-500 group-hover:scale-105" 
                        />
                        <div class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                            </svg>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>

    <!-- Kleine Unterteilung zwischen Foto- und Video-Karussell -->
    <div class="divider divider-primary max-w-xs mx-auto my-12 opacity-20"></div>

    <!-- Unterabschnitt 2: Videos -->
    <div id="videos">
        <div class="text-center mb-8">
            <p class="text-sm opacity-80">Live impressions and energetic highlights.</p>
        </div>

        <div class="carousel carousel-center w-full space-x-4 p-4 bg-base-200/60 rounded-2xl shadow-xl border border-primary/20">
            {videos.map((video, idx) => (
                <div class="carousel-item w-72 md:w-80">
                    <div 
                        class="video-trigger relative w-full rounded-xl overflow-hidden shadow-lg bg-base-100 aspect-video group cursor-pointer border border-primary/20" 
                        data-index={idx}
                        title={video.caption}
                    >
                        <video preload="metadata" muted playsinline class="w-full h-full object-cover pointer-events-none">
                            <source src={`${video.src}#t=0.001`} type="video/mp4" />
                        </video>
                        <div class="absolute inset-0 bg-black/30 flex items-center justify-center transition-opacity group-hover:bg-black/40">
                            <div class="w-12 h-12 rounded-full bg-primary/90 text-primary-content flex items-center justify-center shadow-md transition-transform group-hover:scale-110">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- MODAL FÜR FOTOS -->
<dialog id="photo-modal" class="modal">
    <div class="modal-box bg-base-100 shadow-2xl border-none max-w-3xl p-6 text-center relative flex flex-col items-center">
        <div class="relative w-full flex items-center justify-center min-h-[50vh]">
            <button id="prev-photo-btn" class="absolute left-2 z-10 btn btn-circle btn-sm bg-base-100/90 hover:bg-primary hover:text-primary-content border-none shadow-md">❮</button>
            <img id="modal-photo-img" src="" alt="" class="max-h-[75vh] w-auto object-contain rounded-xl shadow-lg mx-auto" />
            <button id="next-photo-btn" class="absolute right-2 z-10 btn btn-circle btn-sm bg-base-100/90 hover:bg-primary hover:text-primary-content border-none shadow-md">❯</button>
        </div>
        
        <!-- Caption -->
        <p id="photo-modal-caption" class="text-sm font-medium mt-4 text-center opacity-90"></p>

        <div class="modal-action pt-2 justify-center w-full">
            <form method="dialog">
                <button class="btn btn-sm btn-outline border-primary/50 hover:bg-primary hover:border-primary hover:text-primary-content uppercase tracking-wider px-6 font-semibold">Close</button>
            </form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>Close</button></form>
</dialog>

<!-- MODAL FÜR VIDEOS -->
<dialog id="video-modal" class="modal">
    <div class="modal-box bg-base-100 shadow-2xl border-none max-w-3xl p-6 text-center relative flex flex-col items-center">
        <div class="relative w-full flex items-center justify-center min-h-[50vh]">
            <button id="prev-video-btn" class="absolute left-2 z-10 btn btn-circle btn-sm bg-base-100/90 hover:bg-primary hover:text-primary-content border-none shadow-md">❮</button>
            <video id="modal-video-player" controls autoplay class="max-h-[75vh] w-auto object-contain rounded-xl shadow-lg mx-auto">
                <source id="modal-video-source" src="" type="video/mp4">
            </video>
            <button id="next-video-btn" class="absolute right-2 z-10 btn btn-circle btn-sm bg-base-100/90 hover:bg-primary hover:text-primary-content border-none shadow-md">❯</button>
        </div>
        
        <!-- Caption -->
        <p id="video-modal-caption" class="text-sm font-medium mt-4 text-center opacity-90"></p>

        <div class="modal-action pt-2 justify-center w-full">
            <form method="dialog">
                <button id="close-video-btn" class="btn btn-sm btn-outline border-primary/50 hover:bg-primary hover:border-primary hover:text-primary-content uppercase tracking-wider px-6 font-semibold">Close</button>
            </form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button id="backdrop-close-video-btn">Close</button></form>
</dialog>

<script define:vars={{ photos, videos }}>
    let currentPhotoIndex = 0;
    let currentVideoIndex = 0;

    // Foto Elemente
    const photoModal = document.getElementById('photo-modal');
    const modalPhotoImg = document.getElementById('modal-photo-img');
    const photoCaption = document.getElementById('photo-modal-caption');
    const nextPhotoBtn = document.getElementById('next-photo-btn');
    const prevPhotoBtn = document.getElementById('prev-photo-btn');
    const photoTriggers = document.querySelectorAll('.photo-trigger');

    // Video Elemente
    const videoModal = document.getElementById('video-modal');
    const modalVideoPlayer = document.getElementById('modal-video-player');
    const modalVideoSource = document.getElementById('modal-video-source');
    const videoCaption = document.getElementById('video-modal-caption');
    const nextVideoBtn = document.getElementById('next-video-btn');
    const prevVideoBtn = document.getElementById('prev-video-btn');
    const videoTriggers = document.querySelectorAll('.video-trigger');
    const closeVideoBtn = document.getElementById('close-video-btn');
    const backdropCloseVideoBtn = document.getElementById('backdrop-close-video-btn');

    // --- FOTO LOGIK ---
    function updatePhotoModal(index) {
        currentPhotoIndex = index;
        const currentPhoto = photos[currentPhotoIndex];
        if (modalPhotoImg) modalPhotoImg.src = currentPhoto.src;
        if (photoCaption) photoCaption.textContent = currentPhoto.caption;
    }

    photoTriggers.forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            const target = e.currentTarget;
            const idx = parseInt(target.dataset.index || '0', 10);
            updatePhotoModal(idx);
            if (photoModal) photoModal.showModal();
        });
    });

    if (nextPhotoBtn) {
        nextPhotoBtn.addEventListener('click', () => {
            updatePhotoModal((currentPhotoIndex + 1) % photos.length);
        });
    }
    if (prevPhotoBtn) {
        prevPhotoBtn.addEventListener('click', () => {
            updatePhotoModal((currentPhotoIndex - 1 + photos.length) % photos.length);
        });
    }

    // --- VIDEO LOGIK ---
    function updateVideoModal(index) {
        currentVideoIndex = index;
        const currentVid = videos[currentVideoIndex];
        if (modalVideoPlayer && modalVideoSource) {
            modalVideoSource.src = currentVid.src;
            if (videoCaption) videoCaption.textContent = currentVid.caption;
            modalVideoPlayer.load();
            modalVideoPlayer.play();
        }
    }

    videoTriggers.forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            const target = e.currentTarget;
            const idx = parseInt(target.dataset.index || '0', 10);
            updateVideoModal(idx);
            if (videoModal) videoModal.showModal();
        });
    });

    if (nextVideoBtn) {
        nextVideoBtn.addEventListener('click', () => {
            updateVideoModal((currentVideoIndex + 1) % videos.length);
        });
    }
    if (prevVideoBtn) {
        prevVideoBtn.addEventListener('click', () => {
            updateVideoModal((currentVideoIndex - 1 + videos.length) % videos.length);
        });
    }

    function stopVideo() {
        if (modalVideoPlayer) {
            modalVideoPlayer.pause();
            modalVideoPlayer.currentTime = 0;
        }
    }

    if (closeVideoBtn) closeVideoBtn.addEventListener('click', stopVideo);
    if (backdropCloseVideoBtn) backdropCloseVideoBtn.addEventListener('click', stopVideo);
    if (videoModal) videoModal.addEventListener('close', stopVideo);

    // --- PFEILTASTEN-STEUERUNG ---
    window.addEventListener('keydown', (e) => {
        if (photoModal && photoModal.open) {
            if (e.key === 'ArrowLeft') {
                updatePhotoModal((currentPhotoIndex - 1 + photos.length) % photos.length);
            } else if (e.key === 'ArrowRight') {
                updatePhotoModal((currentPhotoIndex + 1) % photos.length);
            }
        } else if (videoModal && videoModal.open) {
            if (e.key === 'ArrowLeft') {
                updateVideoModal((currentVideoIndex - 1 + videos.length) % videos.length);
            } else if (e.key === 'ArrowRight') {
                updateVideoModal((currentVideoIndex + 1) % videos.length);
            }
        }
    });
</script>