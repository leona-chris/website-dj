---
interface Props {
  title: string;
}

const { title } = Astro.props;

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="de" data-theme="pastel" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <!-- Google Fonts: Syne & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <!-- SOUNDCLOUD API (Einmalig für alle Komponenten) -->
    <script is:inline src="https://w.soundcloud.com/player/api.js"></script>
</head>
<body class="bg-base-100 text-base-content min-h-screen selection:bg-primary selection:text-primary-content">
    <slot />
</body>
</html>

<style is:global>
    body { 
        font-family: 'Plus Jakarta Sans', sans-serif; 
    }
    h1, h2, h3, .font-display { 
        font-family: 'Syne', sans-serif; 
    }
    
    @keyframes rainbowGlow {
        0% { box-shadow: 0 0 20px rgba(239, 68, 68, 0.4); }
        50% { box-shadow: 0 0 20px rgba(59, 130, 246, 0.4); }
        100% { box-shadow: 0 0 20px rgba(168, 85, 247, 0.4); }
    }
    .rainbow-aura {
        animation: rainbowGlow 6s infinite;
        position: relative;
        z-index: 10;
    }
</style>